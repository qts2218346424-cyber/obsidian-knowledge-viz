# ==============================================================================
# CoreForge 研核 · 开源环境变量配置模板 (.env.example)
# 使用方法：复制本文件为 .env，按需填写即可；也可直接在 Web 设置页可视化配置
# ==============================================================================

# 1. 基础服务监听配置
COREFORGE_PORT=3001
COREFORGE_HOST=127.0.0.1

# 2. 本地 Obsidian 知识库绝对路径（留空则自动加载自带的 sample-vault 体验库）
# Windows 示例：D:\MyObsidianVault
# macOS/Linux 示例：/Users/yourname/Documents/ObsidianVault
COREFORGE_VAULT_PATH=

# 3. 轻量云端大模型兜底配置（推荐 DeepSeek / 硅基流动 / OpenAI / Anthropic）
# 如果你本机已安装 Claude Code / Antigravity / Ollama，此处可留空直接使用本地超级智能体
COREFORGE_AI_API_KEY=
COREFORGE_AI_BASE_URL=https://api.deepseek.com/v1
COREFORGE_AI_MODEL=deepseek-chat
# 可选值: openai | anthropic
COREFORGE_AI_FORMAT=openai
